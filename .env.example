# Variáveis de ambiente lidas por sagan/settings.py.
# Sem elas o projeto roda em modo de desenvolvimento (DEBUG ligado, chave insegura).
# Na Vercel (VERCEL=1) o DEBUG já fica desligado e *.vercel.app é liberado automaticamente.
#
# Gere uma chave com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Domínio próprio, se houver (ex.: https://sagan.meudominio.com)
DJANGO_CSRF_TRUSTED_ORIGINS=
